# Copy this to .env and fill in real values
# Never commit .env to source control

# GitHub Personal Access Token
# Required scopes: repo, read:discussion, write:discussion
GITHUB_TOKEN=ghp_your_token_here

# GitHub Webhook secret (set in repo/org Settings → Webhooks → Secret)
# Leave blank to disable signature verification (dev only)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Shared API key required as `Authorization: Bearer <key>` on every route except
# /webhook/github (verified separately via HMAC above) and /q/health.
# Leave blank ONLY for localhost-only dev — required for anything reachable
# off your own machine, since /mcp/sse and /webhook/trigger have no other auth.
# Generate one with: openssl rand -hex 32
RESOLVR_API_KEY=

# When true, apply_fix/auto_resolve_all stage fixes instead of committing them —
# an explicit confirm_fix (or confirm_all_pending_fixes) call is required before
# anything is written to GitHub. Recommended "true" for any deployment where you
# didn't personally write every fix being applied.
RESOLVR_REQUIRE_CONFIRMATION=false

# Port (default 8080)
PORT=8080
