# Copy this to .env and fill in real values
# Never commit .env to source control

# GitHub Personal Access Token
# Required scopes: repo, read:discussion, write:discussion
# Leave unset/blank to fall back to `gh auth token` (GitHub CLI's active
# session) — no PAT needed locally if you've already run `gh auth login`.
GITHUB_TOKEN=ghp_your_token_here

# Shared API key required as `Authorization: Bearer <key>` on every route except /q/health.
# Required outside dev/test — the server refuses to start without it, since /mcp/sse would
# otherwise have no other auth.
# Generate one with: openssl rand -hex 32
RESOLVR_API_KEY=

# Port (default 8080)
PORT=8080
